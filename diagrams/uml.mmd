classDiagram

class Owner {
    +String name
    +ListPet pets
    +add_pet()
    +get_pets()
}

class Pet {
    +String name
    +String species
    +String breed
    +int age
    +List~Task~ tasks
    +add_task()
    +get_tasks()
}

class Task {
    +String name
    +String category
    +int duration
    +String priority
    +String preferred_time
    +bool recurring
    +mark_complete()
    +get_details()
}

class CarePlan {
    +Pet pet
    +int available_time
    +List~Task~ scheduled_tasks
    +generate_plan()
    +sort_tasks()
    +get_plan()
}

Owner "1" o-- "0..*" Pet : owns
Pet "1" *-- "0..*" Task : contains
CarePlan "1" --> "1" Pet : for
CarePlan "1" --> "0..*" Task : schedules